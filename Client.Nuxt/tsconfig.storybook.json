{
    "compilerOptions": {
        "paths": {
            "#shared/*": [
                "./shared/*"
            ],
            
            "#components/*": [
                "./app/components/*"
            ],

            "#composables/*": [
                "./app/composables/*"
            ],

            "#storybook/*": [
                "./.storybook/*"
            ]
        }
    },
    
    "include": [
        "./.storybook/**/*",
        "./stories/**/*",
    ]
}